---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Chip from '../../components/Chip.astro';
import { COLUMNS, COLLECTIONS } from '../../data/site';
import { inColumn, urlFor, linkFor } from '../../data/content';

export async function getStaticPaths() {
  return COLUMNS.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const col = COLUMNS.find((c) => c.slug === slug)!;
const items = await inColumn(col.slug);

// 专栏下按"有无专题"分组：有专题的归入专题卡，无专题的直接列出来（旁路 A）
const cols = COLLECTIONS.filter((c) => c.column === col.slug);
const loose = items.filter((n) => !n.data.collection);
---

<Base title={col.name} description={col.desc} current="columns">
  <div class="container">
    <Breadcrumb items={[
      { label: '首页', href: '/' },
      { label: '专栏', href: '/columns/' },
      { label: col.name },
    ]} />

    <header class="page-head">
      <p class="kicker">Column</p>
      <h1 class="page-head__title">{col.name}</h1>
      <p class="page-head__dek">{col.desc}</p>
      <p class="page-head__meta">
        <span>{items.length} 篇</span>
        <span>{cols.length} 个专题</span>
      </p>
    </header>

    {cols.length > 0 && (
      <section style="padding-bottom:var(--s9)">
        <div class="list-head">
          <p class="kicker">Collections</p>
        </div>
        <div class="collection-grid">
          {cols.map((c) => (
            <a class="collection-card" href={`/collections/${c.slug}/`}>
              <div class="collection-card__top">
                <span class="collection-card__num" style="font-size:22px">
                  {items.filter((n) => n.data.collection === c.slug).length} 篇
                </span>
                <Chip maturity={c.maturity} />
              </div>
              <h2 class="collection-card__title">{c.name}</h2>
              <p class="collection-card__dek">{c.intro}</p>
              <div class="collection-card__foot">
                <span class="collection-card__link">
                  开始阅读
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {loose.length > 0 && (
      <section style="padding-bottom:var(--s10)">
        <div class="list-head">
          <p class="kicker">Loose</p>
          <p class="list-head__hint">没进专题的散篇——小题材，不值得成组</p>
        </div>
        <div class="article-list">
          {loose.map((n) => (
            <a class="article-row" href={linkFor(n)}>
              <span class="article-row__date">{n.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}</span>
              <div>
                <h2 class="article-row__title">{n.data.title}</h2>
                {n.data.summary && <p class="article-row__dek">{n.data.summary}</p>}
              </div>
              <span class="article-row__side"><Chip maturity={n.data.maturity} /></span>
            </a>
          ))}
        </div>
      </section>
    )}

    {items.length === 0 && (
      <p class="rail__note">这个专栏还在筹备，暂时没有内容。</p>
    )}
  </div>
</Base>
